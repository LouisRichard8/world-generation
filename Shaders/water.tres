code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 Water_Color : source_color = vec4(0.101718, 0.368618, 0.999991, 1.000000);
uniform sampler2D tex_frg_2 : source_color;
uniform float Transparency = 0.80000001192093;
uniform float Roughness = 0.20000000298023;
uniform sampler2D tex_frg_4;
uniform sampler2D tex_frg_3 : hint_normal;



void fragment() {
// ColorParameter:5
	vec4 n_out5p0 = Water_Color;


// UVFunc:9
	vec2 n_in9p1 = vec2(0.05000, 0.05000);
	vec2 n_in9p2 = vec2(0.00000, 0.00000);
	vec2 n_out9p0 = n_in9p2 * n_in9p1 + UV;


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, n_out9p0);


// VectorOp:6
	vec4 n_out6p0 = n_out5p0 + n_out2p0;


// FloatParameter:7
	float n_out7p0 = Transparency;


// FloatParameter:8
	float n_out8p0 = Roughness;


// Texture2D:4
	vec4 n_out4p0 = texture(tex_frg_4, UV);


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out9p0);


// Output:0
	ALBEDO = vec3(n_out6p0.xyz);
	ALPHA = n_out7p0;
	ROUGHNESS = n_out8p0;
	SPECULAR = n_out4p0.x;
	NORMAL_MAP = vec3(n_out3p0.xyz);


}
